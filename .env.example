# Picare Core Server environment template
# Copy to .env.development for local runs. Production is injected from the
# PICARE_HUB_PRODUCTION_ENV GitHub secret into the VPS .env file.
# Never commit real passwords, tokens, API keys, or SMTP App Passwords.

# Application
NODE_ENV=development
APP_VERSION=1.0.0
SERVER_PORT=1905
GRPC_PORT=50051
SERVER_BASE_URL=http://localhost:1905
LOG_LEVEL=info

# Keep empty when clients connect directly to Express. Use the exact trusted
# proxy hop count in production; the current Nginx deployment uses 1.
TRUST_PROXY=

# CORS clients
ALLOWED_CLIENT_URL_1=http://localhost:5173
ALLOWED_CLIENT_URL_2=http://localhost:5174
ALLOWED_CLIENT_URL_3=http://localhost:5175
ALLOWED_CLIENT_URL_4=http://localhost:5176
ALLOWED_CLIENT_URL_5=http://localhost:5177

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=picare_core_db_local
DB_USER=picare_dev
DB_PASSWORD=replace-with-a-strong-database-password

# Destructive reset flags must remain false in production.
DB_RESET=false
DB_FORCE_RESET=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6381
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Optional dedicated Redis event bus. Leave host/port empty to reuse REDIS_*.
REDIS_EVENT_BUS_HOST=
REDIS_EVENT_BUS_PORT=
REDIS_EVENT_BUS_PASSWORD=

# JWT and login security
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=1d
AUTH_LOGIN_VERIFICATION_ENABLED=true
AUTH_OTP_SECRET=replace-with-a-different-32-byte-random-secret
AUTH_LOGIN_OTP_TTL_SECONDS=300
AUTH_LOGIN_OTP_MAX_ATTEMPTS=5
AUTH_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_LOGIN_OTP_MAX_RESENDS=3

# Failed-login rate limiting
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX_PER_IP=50
AUTH_LOGIN_RATE_LIMIT_MAX_PER_ACCOUNT=10

# Trusted login IP policy
AUTH_TRUSTED_IP_TTL_DAYS=30
AUTH_TRUSTED_IP_MAX_RECORDS=10

# SMTP transport
# Port 587 uses SMTP_SECURE=false; port 465 uses SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_PASS=replace-with-the-mailbox-app-password

# Login verification sender. SMTP_PASS must belong to AUTH_SMTP_USER (or to a
# mailbox configured to send as this address).
AUTH_SMTP_USER=verified-sender@example.com
AUTH_MAIL_FROM=verified-sender@example.com
AUTH_MAIL_FROM_NAME=Picare Client

# Other mail identities. Configure only identities used by the deployment.
ECONTRACT_SMTP_USER=verified-sender@example.com
ECONTRACT_MAIL_FROM=verified-sender@example.com
ECONTRACT_MAIL_FROM_NAME=Picare E-Contract
LICENSE_SMTP_USER=verified-sender@example.com
LICENSE_MAIL_FROM=verified-sender@example.com
LICENSE_MAIL_FROM_NAME=Picare License
SALEFORCE_MAIL_USER=verified-sender@example.com
SALEFORCE_MAIL_FROM=verified-sender@example.com
SALEFORCE_MAIL_FROM_NAME=Picare Salesforce

# S3-compatible storage
AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=replace-with-bucket-name

# Protect storage gRPC in production. Every calling service must send the same
# x-service-token before changing this flag from false to true.
GRPC_STORAGE_AUTH_ENABLED=false
GRPC_STORAGE_SERVICE_TOKEN=replace-with-a-long-random-service-token
GRPC_STORAGE_ALLOWED_PREFIXES=picare-intelligent/

# Upload worker
MAX_FILE_UPLOAD_MB=2048
S3_UPLOAD_STAGING_DIR=./tmp/s3-uploads
S3_UPLOAD_CONCURRENCY=1
S3_UPLOAD_LOCK_DURATION_MS=900000

# Contract PDF generation
CONTRACT_FONT_PATH=./src/assets/fonts/times.ttf
CONTRACT_BOLD_FONT_PATH=./src/assets/fonts/timesbd.ttf
PDF_SIGNATURE_PLACEHOLDER_LENGTH=16384

# Optional FPT AI identity recognition
FPT_AI_API_KEY=
FPT_AI_ID_RECOGNITION_URL=https://api.fpt.ai/vision/idr/vnm/
